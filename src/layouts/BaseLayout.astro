---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { SITE, THEME } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  /** Who the page speaks as: "handle" for the pages players share (games, blog, art). */
  persona?: "name" | "handle";
}

const {
  persona = "name",
  title = `${SITE.fullName} - game developer`,
  description = "Florian Noirbent builds real-time destruction systems and gameplay tooling focused on runtime geometry, performance, and reliable content workflows.",
  image = persona === "handle" ? SITE.handleArtwork : SITE.portrait,
  noindex = false,
  ogType = "website"
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site ?? SITE.url).toString()} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site ?? SITE.url).toString()} />

    <script is:inline define:vars={{ themeKey: THEME.storageKey }}>
      // Applies the theme before the first paint. "system" (the default, nothing
      // stored) follows prefers-color-scheme live; "light"/"dark" are explicit.
      (() => {
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const read = () => {
          try {
            const value = localStorage.getItem(themeKey);
            return value === "light" || value === "dark" ? value : "system";
          } catch {
            return "system";
          }
        };
        const apply = (preference = read()) => {
          const dark = preference === "dark" || (preference === "system" && media.matches);
          const root = document.documentElement;
          root.classList.toggle("dark", dark);
          root.style.colorScheme = dark ? "dark" : "light";
          root.dataset.theme = preference;
          window.dispatchEvent(new CustomEvent("themechange", { detail: preference }));
        };
        const set = (preference) => {
          try {
            if (preference === "system") localStorage.removeItem(themeKey);
            else localStorage.setItem(themeKey, preference);
          } catch {}
          apply(preference);
        };
        apply();
        const refresh = () => apply();
        // Follow the OS setting live (addListener for older Safari), and re-check
        // when the tab comes back in case a change event was missed.
        if (media.addEventListener) media.addEventListener("change", refresh);
        else media.addListener(refresh);
        window.addEventListener("focus", refresh);
        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState === "visible") refresh();
        });
        window.addEventListener("storage", (event) => {
          if (event.key === themeKey || event.key === null) apply();
        });
        window.siteTheme = { get: read, set };
      })();
    </script>

    <title>{title}</title>
  </head>
  <body class="h-full">
    <a
      href="#main-content"
      class="sr-only left-4 top-4 z-50 rounded-md bg-cyan-600 px-3 py-2 font-medium text-white focus:not-sr-only focus:absolute"
    >
      Skip to content
    </a>

    <div class="relative flex min-h-screen flex-col">
      <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-80 bg-gradient-to-b from-cyan-100 to-transparent dark:from-cyan-950/40"></div>
      <Header currentPath={Astro.url.pathname} />
      <main id="main-content" class="mx-auto w-full max-w-6xl flex-1 px-4 pb-16 pt-10 sm:px-6 lg:px-8">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
