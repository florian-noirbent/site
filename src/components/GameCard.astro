---
import Tag from "./Tag.astro";
import StatusBadge from "./StatusBadge.astro";
import { gameUrl, type Game } from "../lib/games";
import { formatMonthYear } from "../lib/format";

interface Props {
  game: Game;
}

const { game } = Astro.props;
const { title, description, cardImage, date, engine, platforms, status, cardStyle, highlighted, supremapp } = game.data;
---

<a
  href={gameUrl(game)}
  class:list={[
    "surface group block h-full transition hover:-translate-y-0.5 hover:border-cyan-300 hover:shadow-md dark:hover:border-cyan-700",
    highlighted &&
      "border-cyan-400/80 shadow-[0_0_0_1px_rgba(34,211,238,0.5),0_0_34px_rgba(34,211,238,0.35)] dark:border-cyan-600/80 dark:shadow-[0_0_0_1px_rgba(34,211,238,0.45),0_0_40px_rgba(34,211,238,0.28)]"
  ]}
>
  <article class="flex h-full flex-col gap-4">
    <div class="relative">
      <img
        src={cardImage}
        alt={`${title} cover image`}
        class:list={[
          "h-44 w-full rounded-xl border border-slate-200 dark:border-slate-700",
          cardStyle === "icon" ? "bg-slate-100 p-3 object-contain dark:bg-slate-800" : "object-cover"
        ]}
        loading="lazy"
      />
      {
        supremapp && (
          <img
            src="/images/games/suprem-app.png"
            alt="SupremApp logo"
            class="absolute right-2 top-2 h-20 w-20 object-contain"
            loading="lazy"
          />
        )
      }
    </div>

    <div class="flex items-center justify-between gap-4">
      <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100">
        {title}
        {
          highlighted && (
            <span class="ml-2 align-middle text-xl leading-none text-amber-500 dark:text-amber-400" aria-hidden="true">
              ★
            </span>
          )
        }
      </h3>
      <StatusBadge status={status} />
    </div>

    <p class="text-sm text-slate-700 dark:text-slate-300">{description}</p>

    <dl class="grid grid-cols-1 gap-1 text-xs text-slate-600 dark:text-slate-400">
      <div><dt class="inline font-semibold">Release:</dt> <dd class="inline">{formatMonthYear(date)}</dd></div>
      <div><dt class="inline font-semibold">Engine:</dt> <dd class="inline">{engine}</dd></div>
    </dl>

    <div class="mt-auto flex flex-wrap gap-2">
      {platforms.map((platform) => <Tag label={platform} />)}
    </div>
  </article>
</a>
