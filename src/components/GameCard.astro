---
import StatusBadge from "./StatusBadge.astro";
import { gameUrl, type Game } from "../lib/games";
import { formatMonthYear } from "../lib/format";

interface Props {
  game: Game;
}

const { game } = Astro.props;
const { title, description, cardImage, date, engine, platforms, status, cardStyle, highlighted, supremapp } = game.data;
const meta = [formatMonthYear(date), engine, platforms.join(", ")].join(" \u00b7 ");
---

<a
  href={gameUrl(game)}
  class:list={[
    "card card-link group",
    highlighted &&
      "border-cyan-400/80 shadow-[0_0_0_1px_rgba(34,211,238,0.5),0_0_34px_rgba(34,211,238,0.35)] dark:border-cyan-600/80 dark:shadow-[0_0_0_1px_rgba(34,211,238,0.45),0_0_40px_rgba(34,211,238,0.28)]"
  ]}
>
  <article class="flex h-full flex-col">
    <div class="relative">
      <img
        src={cardImage}
        alt={`${title} cover image`}
        class:list={[
          "card-media h-44",
          cardStyle === "icon" ? "bg-slate-100 object-contain p-3 dark:bg-slate-800" : "object-cover"
        ]}
        loading="lazy"
      />
      {
        supremapp && (
          <img
            src="/images/games/suprem-app.png"
            alt="SupremApp logo"
            class="absolute right-2 top-2 h-20 w-20 object-contain"
            loading="lazy"
          />
        )
      }
    </div>

    <div class="flex flex-1 flex-col gap-3 p-5">
      <div class="flex items-center justify-between gap-4">
        <h3 class="text-lg font-bold text-slate-900 group-hover:text-cyan-700 dark:text-slate-100 dark:group-hover:text-cyan-300">
          {title}
          {
            highlighted && (
              <span class="ml-2 align-middle text-xl leading-none text-amber-500 dark:text-amber-400" aria-hidden="true">
                ★
              </span>
            )
          }
        </h3>
        <StatusBadge status={status} />
      </div>

      <p class="text-sm text-slate-700 dark:text-slate-300">{description}</p>

      <p class="mt-auto pt-1 text-xs font-medium text-slate-500 dark:text-slate-400">{meta}</p>
    </div>
  </article>
</a>
