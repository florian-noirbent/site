---
import { CONTACT_LINKS, SITE } from "../config/site";

const year = new Date().getFullYear();
const linkClass = "hover:text-cyan-700 dark:hover:text-cyan-300";
---

<footer class="border-t border-slate-200/80 bg-white/75 py-8 dark:border-slate-800 dark:bg-slate-950/70">
  <div class="mx-auto flex w-full max-w-6xl flex-col items-start justify-between gap-4 px-4 text-sm text-slate-600 sm:flex-row sm:items-center sm:px-6 lg:px-8 dark:text-slate-400">
    <p>
      &copy; {year} {SITE.fullName}. All rights reserved.
      <a class:list={["ml-2", linkClass]} href="/privacy">Privacy</a>
    </p>
    <nav aria-label="Contact links">
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-2">
        {
          CONTACT_LINKS.map((link) => (
            <li>
              <a
                class={linkClass}
                href={link.href}
                {...(link.href.startsWith("mailto:") ? {} : { target: "_blank", rel: "noreferrer noopener" })}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
