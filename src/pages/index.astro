---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CardGrid from "../components/CardGrid.astro";
import GameGrid from "../components/GameGrid.astro";
import PostGrid from "../components/PostGrid.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { getFeaturedGames } from "../lib/games";
import { getRecentPosts } from "../lib/blog";
import { byDateDesc } from "../lib/format";
import { HOME, ROUTES } from "../config/site";

const featuredAssets = (await getCollection("assets")).filter((asset) => asset.data.featured).sort(byDateDesc);
const featuredGames = await getFeaturedGames();
const recentPosts = await getRecentPosts(HOME.recentPostCount);
---

<BaseLayout title="Titan" description="Home of Titan's portfolio: featured games, articles and assets.">
  <section class="grid gap-6 lg:grid-cols-[1.35fr_0.65fr] lg:items-stretch">
    <div class="surface flex h-full flex-col justify-center">
      <h1 class="text-4xl font-bold">
        Real-time Systems & Technical Game Development
      </h1>

      <p class="mt-4 max-w-2xl text-slate-700 dark:text-slate-300">
        I build gameplay systems, rendering pipelines, and procedural tools -
        from production backend systems to real-time VFX and physics-driven mechanics.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a class="button-primary" href="/assets">View Assets</a>
        <a class="button-secondary" href="/contact">Contact</a>
      </div>
    </div>

    <aside class="surface p-2">
      <img
        src="/images/mecha-signature.jpg"
        alt="Titan signature mecha artwork"
        class="h-full min-h-[280px] w-full rounded-xl border border-slate-200 object-cover dark:border-slate-700"
        loading="lazy"
      />
    </aside>
  </section>

  <div class="mt-12 space-y-12">
    <PostGrid title="Recent Articles" posts={recentPosts} link={{ href: ROUTES.blog, label: "See all articles" }} />

    <GameGrid title="Featured Games" games={featuredGames} link={{ href: ROUTES.games, label: "See all games" }} />

    {
      featuredAssets.length > 0 && (
        <section>
          <SectionHeading title="Featured Assets" link={{ href: ROUTES.assets, label: "See all assets" }} />
          <CardGrid>
            {featuredAssets.map((asset) => (
              <ProjectCard
                title={asset.data.title}
                description={asset.data.description}
                image={asset.data.cardImage}
                tags={asset.data.tags}
                href={`${ROUTES.assets}/${asset.slug}`}
                status={asset.data.status}
              />
            ))}
          </CardGrid>
        </section>
      )
    }
  </div>
</BaseLayout>
