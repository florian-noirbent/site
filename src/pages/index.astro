---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import GameCard from "../components/GameCard.astro";

const assets = await getCollection("assets");
const featured = assets
  .filter((asset) => asset.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featuredGames = (await getCollection("games"))
  .filter((game) => game.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  year: "numeric"
});
---

<BaseLayout title="Titan" description="Home of Titan's portfolio, featured games and assets.">
  <section class="grid gap-6 lg:grid-cols-[1.35fr_0.65fr] lg:items-stretch">
    <div class="surface flex h-full flex-col justify-center">
      <h1 class="text-4xl font-bold">
        Real-time Systems & Technical Game Development
      </h1>

      <p class="mt-4 max-w-2xl text-slate-700 dark:text-slate-300">
        I build gameplay systems, rendering pipelines, and procedural tools -
        from production backend systems to real-time VFX and physics-driven mechanics.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a class="button-primary" href="/assets">View Assets</a>
        <a class="button-secondary" href="/contact">Contact</a>
      </div>
    </div>

    <aside class="surface p-2">
      <img
        src="/images/mecha-signature.jpg"
        alt="Titan signature mecha artwork"
        class="h-full min-h-[280px] w-full rounded-xl border border-slate-200 object-cover dark:border-slate-700"
        loading="lazy"
      />
    </aside>
  </section>

  {
    featuredGames.length > 0 && (
      <section class="mt-12">
        <div class="mb-6 flex items-center justify-between gap-4">
          <h2 class="text-2xl font-bold">Featured Games</h2>
          <a class="text-sm font-semibold text-cyan-700 hover:underline dark:text-cyan-300" href="/games">
            See all games
          </a>
        </div>
        <div class="grid gap-5 md:grid-cols-2">
          {featuredGames.map((game) => (
            <GameCard
              title={game.data.title}
              description={game.data.description}
              image={game.data.cardImage}
              href={`/games/${game.slug}`}
              dateLabel={dateFormatter.format(game.data.date)}
              engine={game.data.engine}
              platforms={game.data.platforms}
              status={game.data.status}
              cardStyle={game.data.cardStyle}
              highlighted={game.data.highlighted}
              supremapp={game.data.supremapp}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="mt-12">
    <div class="mb-6 flex items-center justify-between gap-4">
      <h2 class="text-2xl font-bold">Featured Assets</h2>
      <a class="text-sm font-semibold text-cyan-700 hover:underline dark:text-cyan-300" href="/assets">
        See all assets
      </a>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      {
        featured.map((asset) => (
          <ProjectCard
            title={asset.data.title}
            description={asset.data.description}
            image={asset.data.cardImage}
            tags={asset.data.tags}
            href={`/assets/${asset.slug}`}
            status={asset.data.status}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
