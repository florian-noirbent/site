---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameGrid from "../../components/GameGrid.astro";
import { getGames, groupGames } from "../../lib/games";

const groups = groupGames(await getGames());
---

<BaseLayout persona="handle" title="Games | Titan" description="Game projects shipped and prototyped by Titan (Florian Noirbent).">
  <section>
    <h1 class="text-3xl font-extrabold sm:text-4xl">Games</h1>
    <p class="mt-4 max-w-3xl text-slate-700 dark:text-slate-300">
      A selection of web, mobile, and student game projects spanning arcade, runner, puzzle, automation, and experimental multiplayer prototypes. Developed independently and with SupremApp.
    </p>
    <p class="mt-4 max-w-3xl text-slate-700 dark:text-slate-300">
      Contractual work is not included here.
    </p>
  </section>

  <div class="mt-8 space-y-10">
    {groups.map((group) => <GameGrid title={group.title} games={group.games} />)}
  </div>
</BaseLayout>
