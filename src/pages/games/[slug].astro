---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LinkButtons from "../../components/LinkButtons.astro";
import PostGrid from "../../components/PostGrid.astro";
import Prose from "../../components/Prose.astro";
import { getGameLinks, getGames } from "../../lib/games";
import { getPostsForGame, tagUrl } from "../../lib/blog";
import { formatMonthYear } from "../../lib/format";
import { ROUTES, SITE } from "../../config/site";
import Byline from "../../components/Byline.astro";

export async function getStaticPaths() {
  const games = await getGames();
  return games.map((game) => ({
    params: { slug: game.slug },
    props: { game }
  }));
}

const { game } = Astro.props;
const { Content } = await render(game);

const dateLabel = formatMonthYear(game.data.date, "long");
const links = getGameLinks(game);
const posts = await getPostsForGame(game);

const statusLabel = game.data.status === "released" ? "Released" : "Unreleased";
---

<BaseLayout persona="handle" title={`${game.data.title} | Games | ${SITE.handle}`} description={game.data.description} image={game.data.cardImage}>
  <a class="button-secondary mb-6 inline-flex" href={ROUTES.games}>Back to Games</a>

  <article class="space-y-8">
    <header class="surface">
      <div
        class:list={[
          "grid gap-6 lg:items-start",
          game.data.supremapp ? "lg:grid-cols-[1fr_280px_auto]" : "lg:grid-cols-[1fr_280px]"
        ]}
      >
        <div>
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-cyan-700 dark:text-cyan-300">Game detail</p>
          <h1 class="text-3xl font-extrabold sm:text-4xl">{game.data.title}</h1>
          <p class="mt-4 max-w-3xl text-slate-700 dark:text-slate-300">{game.data.description}</p>
          <div class="mt-4"><Byline /></div>

          <dl class="mt-6 grid gap-3 text-sm sm:grid-cols-2">
            <div>
              <dt class="font-semibold text-slate-900 dark:text-slate-100">Release</dt>
              <dd class="text-slate-700 dark:text-slate-300">{dateLabel}</dd>
            </div>
            <div>
              <dt class="font-semibold text-slate-900 dark:text-slate-100">Status</dt>
              <dd class="text-slate-700 dark:text-slate-300">{statusLabel}</dd>
            </div>
            <div>
              <dt class="font-semibold text-slate-900 dark:text-slate-100">Engine</dt>
              <dd class="text-slate-700 dark:text-slate-300">{game.data.engine}</dd>
            </div>
            <div>
              <dt class="font-semibold text-slate-900 dark:text-slate-100">Platforms</dt>
              <dd class="text-slate-700 dark:text-slate-300">{game.data.platforms.join(", ")}</dd>
            </div>
            {
              game.data.releaseNote && (
                <div class="sm:col-span-2">
                  <dt class="font-semibold text-slate-900 dark:text-slate-100">Note</dt>
                  <dd class="text-slate-700 dark:text-slate-300">{game.data.releaseNote}</dd>
                </div>
              )
            }
          </dl>
        </div>

        <div class="w-full">
          <img
            src={game.data.cardImage}
            alt={`${game.data.title} cover image`}
            class="w-full rounded-xl border border-slate-200 object-cover dark:border-slate-700"
            loading="lazy"
          />
        </div>
        {
          game.data.supremapp && (
            <div class="flex justify-end lg:justify-start">
              <div class="rounded-lg border border-slate-200 bg-white p-2 shadow-sm dark:border-slate-700 dark:bg-white">
                <img src="/images/games/suprem-app.png" alt="SupremApp logo" class="h-20 w-20 object-contain" loading="lazy" />
              </div>
            </div>
          )
        }
      </div>
      {
        links.length > 0 && (
          <div class="mt-6">
            <LinkButtons links={links} />
          </div>
        )
      }
    </header>

    <Prose>
      <Content />
    </Prose>

    <PostGrid
      title="Blog posts"
      posts={posts}
      link={{ href: tagUrl(game.slug), label: "Open in blog" }}
    />
  </article>

  <script is:inline>
    (() => {
      const carousels = document.querySelectorAll("[data-carousel]");
      if (!carousels.length) return;

      const activeDotClasses = ["bg-cyan-600", "dark:bg-cyan-400"];
      const inactiveDotClasses = ["bg-slate-300", "dark:bg-slate-600"];

      carousels.forEach((carousel) => {
        const track = carousel.querySelector("[data-carousel-track]");
        const prevButton = carousel.querySelector("[data-carousel-prev]");
        const nextButton = carousel.querySelector("[data-carousel-next]");
        const dots = Array.from(carousel.querySelectorAll("[data-carousel-dot]"));
        if (!track || !dots.length) return;

        const slides = Array.from(track.children);
        if (!slides.length) return;

        let currentIndex = 0;

        const getSlideWidth = () => {
          const firstSlide = slides[0];
          if (!firstSlide) return 0;
          return firstSlide.getBoundingClientRect().width;
        };

        const getStepSize = () => {
          const slideWidth = getSlideWidth();
          if (!slideWidth) return 1;
          return Math.max(1, Math.round(track.clientWidth / slideWidth));
        };

        const setActiveDot = (index) => {
          dots.forEach((dot, dotIndex) => {
            const isActive = dotIndex === index;
            dot.classList.toggle(activeDotClasses[0], isActive);
            dot.classList.toggle(activeDotClasses[1], isActive);
            dot.classList.toggle(inactiveDotClasses[0], !isActive);
            dot.classList.toggle(inactiveDotClasses[1], !isActive);
            dot.setAttribute("aria-current", isActive ? "true" : "false");
          });
        };

        const scrollToIndex = (index) => {
          const slideWidth = getSlideWidth();
          if (!slideWidth) return;
          currentIndex = Math.max(0, Math.min(index, slides.length - 1));
          track.scrollTo({ left: slideWidth * currentIndex, behavior: "smooth" });
          setActiveDot(currentIndex);
        };

        const syncFromScroll = () => {
          const slideWidth = getSlideWidth();
          if (!slideWidth) return;
          const nextIndex = Math.round(track.scrollLeft / slideWidth);
          if (nextIndex === currentIndex) return;
          currentIndex = Math.max(0, Math.min(nextIndex, slides.length - 1));
          setActiveDot(currentIndex);
        };

        prevButton?.addEventListener("click", () => scrollToIndex(currentIndex - getStepSize()));
        nextButton?.addEventListener("click", () => scrollToIndex(currentIndex + getStepSize()));
        dots.forEach((dot, index) => dot.addEventListener("click", () => scrollToIndex(index)));
        track.addEventListener("scroll", syncFromScroll, { passive: true });
        window.addEventListener("resize", () => scrollToIndex(currentIndex));

        setActiveDot(currentIndex);
      });
    })();
  </script>
</BaseLayout>
